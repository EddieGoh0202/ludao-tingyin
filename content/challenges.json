[
  { "id": "c-lc01", "soundId": "lc01", "type": "listen_choose", "prompt": "听一听，这句话是什么意思？", "options": ["你好", "再见", "谢谢"], "answer": 0, "explain": "「汝」= 你，「好」= 好，合起来就是「你好」。" },
  { "id": "c-lc02", "soundId": "lc02", "type": "listen_choose", "prompt": "清早听到「Gâu-tsá」，对方在说什么？", "options": ["早安", "晚安", "慢走"], "answer": 0, "explain": "「Gâu-tsá」字面是「很早」，用作早安问候。" },
  { "id": "c-lc03", "soundId": "lc03", "type": "dialogue_choice", "prompt": "隔壁阿伯问：「食饱未？」你该怎么回？", "options": ["食饱矣，多谢！", "我欲转去矣。", "今仔日真闹热。"], "answer": 0, "explain": "「食饱矣」= 吃饱了，是最常见也最礼貌的回应。" },
  { "id": "c-lc04", "soundId": "lc04", "type": "listen_choose", "prompt": "「A-má」指的是谁？", "options": ["外婆 / 奶奶", "妈妈", "姐姐"], "answer": 0, "explain": "在闽南话里父系母系的祖母都可以叫「阿嬷」。" },
  { "id": "c-lc05", "soundId": "lc05", "type": "listen_choose", "prompt": "「A-kong」指的是谁？", "options": ["爷爷 / 外公", "舅舅", "哥哥"], "answer": 0, "explain": "「阿公」是祖父辈的称呼。" },
  { "id": "c-lc06", "soundId": "lc06", "type": "dialogue_choice", "prompt": "阿嬷递茶给你，你说「多谢」。她最可能怎么回？", "options": ["免客气", "伤贵矣", "天光矣"], "answer": 0, "explain": "「免客气」= 不用客气。" },
  { "id": "c-lc07", "soundId": "lc07", "type": "listen_choose", "prompt": "「Bián kheh-khì」是什么意思？", "options": ["不客气", "不要客气地站着", "不必来了"], "answer": 0, "explain": "「免」= 不必，「客气」= 客气。" },
  { "id": "c-lc08", "soundId": "lc08", "type": "find_object", "prompt": "阿嬷说「来食茶」，在图中找出茶壶。", "options": ["茶壶", "菜脯", "藤椅", "收音机", "风狮爷", "竹筛"], "answer": 0, "explain": "闽南人待客先奉茶，「食茶」就是喝茶。" },
  { "id": "c-lc09", "soundId": "lc09", "type": "reorder", "prompt": "把词排成「我回来了」：", "tokens": ["转来", "我", "矣"], "answer": [1, 0, 2], "explain": "语序是「我 + 转来 + 矣」，「矣」是句末语气词。" },
  { "id": "c-lc10", "soundId": "lc10", "type": "listen_choose", "prompt": "「gín-á」指的是？", "options": ["小孩", "邻居", "客人"], "answer": 0, "explain": "「囡仔」是闽南话对小孩的称呼。" },
  { "id": "c-lc11", "soundId": "lc11", "type": "tone_discrimination", "prompt": "「Tsin suí」的声调走向是？先听两个音。", "options": ["先高平后高降", "两个都是低平", "先降后升"], "answer": 0, "explain": "「tsin」阴平 44 高平，「suí」上声 53 高降。" },
  { "id": "c-lc12", "soundId": "lc12", "type": "listen_choose", "prompt": "「hó-sè」表示事情怎么样？", "options": ["妥当、顺利", "糟糕透顶", "还很早"], "answer": 0, "explain": "「好势」常用来表示事情办妥了、状态不错。" },
  { "id": "c-lc13", "soundId": "lc13", "type": "listen_choose", "prompt": "「kóo-tsá-bī」常用来形容什么？", "options": ["传统的老味道", "刚出炉的热度", "古代的书籍"], "answer": 0, "explain": "「古早」= 从前，「味」= 味道。" },
  { "id": "c-lc14", "soundId": "lc14", "type": "listen_choose", "prompt": "「Thinn kng--ah」是什么时候说的话？", "options": ["清晨天刚亮", "正午最热", "深夜要睡"], "answer": 0, "explain": "「天光」= 天亮，「矣」表示变化完成。" },
  { "id": "c-lc15", "soundId": "lc15", "type": "listen_choose", "prompt": "睡前听到「Àm-an」，意思是？", "options": ["晚安", "早上好", "路上小心"], "answer": 0, "explain": "「暗」= 夜晚，「安」= 平安。" },
  { "id": "c-lc16", "soundId": "lc16", "type": "dialogue_choice", "prompt": "阿公看你累了，说「歇睏一下」。他的意思是？", "options": ["先去休息一会儿", "再去干点活", "快点吃饭"], "answer": 0, "explain": "「歇睏」= 休息、睡一会儿。" },
  { "id": "c-lc17", "soundId": "lc17", "type": "listen_choose", "prompt": "「tshù-lāi」指的是？", "options": ["家里", "屋顶", "村外"], "answer": 0, "explain": "「厝」= 房子，「内」= 里面。" },
  { "id": "c-lc18", "soundId": "lc18", "type": "proverb_fill", "prompt": "补全俗谚：「爱拼才会赢」的下一句常接？", "options": ["三分天注定，七分靠打拼", "一寸光阴一寸金", "有理走遍天下"], "answer": 0, "explain": "「三分天注定，七分靠打拼」出自同名歌曲，唱出闽南人的拼搏观。" },
  { "id": "c-lc19", "soundId": "lc19", "type": "listen_choose", "prompt": "「kiánn-sun」是什么意思？", "options": ["子孙后代", "兄弟姐妹", "邻居朋友"], "answer": 0, "explain": "「囝」= 儿子、孩子，「孙」= 孙辈。" },
  { "id": "c-lc20", "soundId": "lc20", "type": "repeat_after", "prompt": "跟读「Tsia̍h-pn̄g」，注意「pn̄g」的鼻音。", "answer": 0, "explain": "「食饭」= 吃饭，「pn̄g」是带鼻音的韵母。" },

  { "id": "c-bs01", "soundId": "bs01", "type": "listen_choose", "prompt": "在八市听到「Tsit ê guā-tsē tsînn?」，这是在问什么？", "options": ["这个多少钱", "这个怎么吃", "这个在哪里"], "answer": 0, "explain": "「偌济」= 多少，「钱」= 钱。" },
  { "id": "c-bs02", "soundId": "bs02", "type": "dialogue_choice", "prompt": "你想让头家娘便宜一点，该说？", "options": ["有较俗无？", "有较贵无？", "有好食无？"], "answer": 0, "explain": "「俗」= 便宜，「有较…无」是闽南话常用的比较问句。" },
  { "id": "c-bs03", "soundId": "bs03", "type": "listen_choose", "prompt": "「Siunn kuì--ah」表达什么？", "options": ["太贵了", "太咸了", "太大了"], "answer": 0, "explain": "「伤」在这里是「太」的意思，「贵」= 贵。" },
  { "id": "c-bs04", "soundId": "bs04", "type": "find_object", "prompt": "找出「ô-á」（海蛎）。", "options": ["海蛎", "花蛤", "小管", "石斑鱼", "土笋冻", "虾"], "answer": 0, "explain": "厦门人说「蚵仔」，就是海蛎。" },
  { "id": "c-bs05", "soundId": "bs05", "type": "listen_choose", "prompt": "「ô-á-tsian」是哪道小吃？", "options": ["海蛎煎", "面线糊", "沙茶面"], "answer": 0, "explain": "「tsian」= 煎，海蛎煎是厦门街头名小吃。" },
  { "id": "c-bs06", "soundId": "bs06", "type": "listen_choose", "prompt": "「hî」是什么？", "options": ["鱼", "虾", "蟹"], "answer": 0, "explain": "厦门腔「鱼」读 hî，台湾腔多读 hû。" },
  { "id": "c-bs07", "soundId": "bs07", "type": "dialogue_choice", "prompt": "卖鱼阿伯说「Tsiok tshinn」。他在夸什么？", "options": ["鱼很新鲜", "鱼很便宜", "鱼很大条"], "answer": 0, "explain": "「鲜」读 tshinn，和「青」同音。" },
  { "id": "c-bs08", "soundId": "bs08", "type": "listen_choose", "prompt": "「tsi̍t kin」是多少？", "options": ["一斤", "一两", "一袋"], "answer": 0, "explain": "「kin」= 斤。" },
  { "id": "c-bs09", "soundId": "bs09", "type": "listen_choose", "prompt": "在市场喊「thâu-ke」，是在叫谁？", "options": ["老板", "顾客", "伙计"], "answer": 0, "explain": "「头家」= 老板，也用于称呼店主。" },
  { "id": "c-bs10", "soundId": "bs10", "type": "listen_choose", "prompt": "「thâu-ke-niû」是？", "options": ["老板娘", "老板的女儿", "女顾客"], "answer": 0, "explain": "在「头家」后加「娘」表示老板娘。" },
  { "id": "c-bs11", "soundId": "bs11", "type": "proverb_fill", "prompt": "厦门名小吃「土笋冻」的原料其实是？", "options": ["海边的星虫", "竹笋", "海带"], "answer": 0, "explain": "土笋冻用的是滩涂里的星虫（土笋），熬煮后凝成冻。" },
  { "id": "c-bs12", "soundId": "bs12", "type": "listen_choose", "prompt": "「tshài-thâu」是哪种菜？", "options": ["萝卜", "白菜", "芹菜"], "answer": 0, "explain": "「菜头」= 萝卜，过年吃菜头粿寓意好彩头。" },
  { "id": "c-bs13", "soundId": "bs13", "type": "listen_choose", "prompt": "「han-tsî」是什么？", "options": ["地瓜", "番茄", "芋头"], "answer": 0, "explain": "「番薯」= 地瓜，是闽南传统主食之一。" },
  { "id": "c-bs14", "soundId": "bs14", "type": "dialogue_choice", "prompt": "想让头家娘多送一点葱，说哪句？", "options": ["Ke sàng tsi̍t-kuá", "Bián tsāu--ah", "Siunn kuì--ah"], "answer": 0, "explain": "「加」= 多，「送」= 送，「一寡」= 一些。" },
  { "id": "c-bs15", "soundId": "bs15", "type": "dialogue_choice", "prompt": "付钱后对找回的零钱说「免找矣」，意思是？", "options": ["不用找零了", "不用袋子了", "不用称了"], "answer": 0, "explain": "「找」= 找零，「免」= 不用。" },
  { "id": "c-bs16", "soundId": "bs16", "type": "listen_choose", "prompt": "「hó-tsia̍h」是什么意思？", "options": ["好吃", "好看", "好贵"], "answer": 0, "explain": "「食」= 吃，闽南话说吃用「食」。" },
  { "id": "c-bs17", "soundId": "bs17", "type": "tone_discrimination", "prompt": "「hê」是阳平，调值是？", "options": ["24 升调", "44 高平", "21 低降"], "answer": 0, "explain": "厦门腔阳平读 24，由中往高升。" },
  { "id": "c-bs18", "soundId": "bs18", "type": "reorder", "prompt": "把词排成「买菜」：", "tokens": ["tshài", "bé"], "answer": [1, 0], "explain": "闽南话动词在前：「bé（买）+ tshài（菜）」。" },
  { "id": "c-bs19", "soundId": "bs19", "type": "listen_choose", "prompt": "「Beh bé siánn-mih?」是头家娘在问？", "options": ["要买什么", "要多少钱", "什么时候来"], "answer": 0, "explain": "「beh」= 要，「siánn-mih」= 什么。" },
  { "id": "c-bs20", "soundId": "bs20", "type": "listen_choose", "prompt": "「秤头足」是什么意思？", "options": ["分量给得足", "秤坏了", "价钱很高"], "answer": 0, "explain": "「秤头」指称出来的分量，「足」= 足够。" },

  { "id": "c-zs01", "soundId": "zs01", "type": "listen_choose", "prompt": "「sa-te-mī」是哪道厦门名小吃？", "options": ["沙茶面", "拌面", "面线糊"], "answer": 0, "explain": "沙茶酱由南洋华侨带回，成了厦门味道的代表。" },
  { "id": "c-zs02", "soundId": "zs02", "type": "listen_choose", "prompt": "「hue-sing-thng」是什么？", "options": ["花生汤", "绿豆汤", "四果汤"], "answer": 0, "explain": "「花生」读 hue-sing，「汤」读 thng。" },
  { "id": "c-zs03", "soundId": "zs03", "type": "listen_choose", "prompt": "中山路两旁那种带长廊的老建筑叫？", "options": ["骑楼", "土楼", "番仔楼"], "answer": 0, "explain": "骑楼底层架空成走廊，适合多雨的厦门。" },
  { "id": "c-zs04", "soundId": "zs04", "type": "tone_discrimination", "prompt": "「Kóo-lōng-sū」三个音节的调型依次是？", "options": ["高降 - 中平 - 中平", "高平 - 高平 - 高降", "低降 - 升调 - 高平"], "answer": 0, "explain": "「Kóo」上声 53，「lōng」「sū」阳去 22。" },
  { "id": "c-zs05", "soundId": "zs05", "type": "listen_choose", "prompt": "「Ē-mn̂g」是哪里？", "options": ["厦门", "金门", "泉州"], "answer": 0, "explain": "厦门旧称「下门」，闽南话读 Ē-mn̂g。" },
  { "id": "c-zs06", "soundId": "zs06", "type": "listen_choose", "prompt": "「kiânn-ke」是什么意思？", "options": ["逛街", "回家", "开车"], "answer": 0, "explain": "「行」= 走，「街」= 街，厦门腔「街」读 ke。" },
  { "id": "c-zs07", "soundId": "zs07", "type": "dialogue_choice", "prompt": "骑楼下有人喊「Lo̍h-hōo--ah」，你该？", "options": ["撑开雨伞", "脱掉外套", "戴上墨镜"], "answer": 0, "explain": "「落雨」= 下雨，「矣」表示已经开始。" },
  { "id": "c-zs08", "soundId": "zs08", "type": "listen_choose", "prompt": "「hōo-suànn」是什么？", "options": ["雨伞", "雨衣", "雨鞋"], "answer": 0, "explain": "「雨」读 hōo，「伞」读 suànn。" },
  { "id": "c-zs09", "soundId": "zs09", "type": "listen_choose", "prompt": "「tī tsia」表示？", "options": ["在这里", "在那里", "去哪里"], "answer": 0, "explain": "「伫」= 在，「遮」= 这里。" },
  { "id": "c-zs10", "soundId": "zs10", "type": "dialogue_choice", "prompt": "游客问「Beh khì tó-uī?」，怎么用闽南话回答「去鼓浪屿」？", "options": ["欲去鼓浪屿", "欲来鼓浪屿", "伫鼓浪屿"], "answer": 0, "explain": "「欲 khì」= 要去，方向助词用「去」。" },
  { "id": "c-zs11", "soundId": "zs11", "type": "listen_choose", "prompt": "「Ti̍t-ti̍t kiânn」是让你怎么走？", "options": ["一直往前走", "马上停下", "原路返回"], "answer": 0, "explain": "「直直」= 一直，「行」= 走。" },
  { "id": "c-zs12", "soundId": "zs12", "type": "listen_choose", "prompt": "「tò-pîng」是哪一边？", "options": ["左边", "右边", "对面"], "answer": 0, "explain": "「倒」= 左，「爿」= 边。闽南话分「倒爿 / 正爿」。" },
  { "id": "c-zs13", "soundId": "zs13", "type": "listen_choose", "prompt": "「tsiànn-pîng」是哪一边？", "options": ["右边", "左边", "后边"], "answer": 0, "explain": "「正」= 右，和「倒（左）」相对。" },
  { "id": "c-zs14", "soundId": "zs14", "type": "proverb_fill", "prompt": "中秋博饼掷几颗骰子？", "options": ["六颗", "四颗", "两颗"], "answer": 0, "explain": "六颗骰子掷入大瓷碗，按「一秀、二举、四进、三红、对堂、状元」得奖。" },
  { "id": "c-zs15", "soundId": "zs15", "type": "listen_choose", "prompt": "博饼里「tsiōng-guân」是？", "options": ["状元（最大奖）", "最小的奖", "主持的人"], "answer": 0, "explain": "状元是博饼的最高等级，通常要掷出四个四点以上。" },
  { "id": "c-zs16", "soundId": "zs16", "type": "listen_choose", "prompt": "「Tiong-tshiu」是哪个节日？", "options": ["中秋节", "端午节", "春节"], "answer": 0, "explain": "「中秋」闽南话读 Tiong-tshiu。" },
  { "id": "c-zs17", "soundId": "zs17", "type": "tone_discrimination", "prompt": "厦门腔「闹热」的「热」，声母接近？", "options": ["l（读 lia̍t）", "j（读 jia̍t）", "r（读 ria̍t）"], "answer": 0, "explain": "厦门腔把日母字读成 l，这是和台湾腔明显不同的一点。" },
  { "id": "c-zs18", "soundId": "zs18", "type": "listen_choose", "prompt": "「hó-sńg」是什么意思？", "options": ["好玩", "好累", "好看"], "answer": 0, "explain": "「耍」读 sńg，意思是玩。" },
  { "id": "c-zs19", "soundId": "zs19", "type": "dialogue_choice", "prompt": "客人要走了，店主说「Bān-bān-á kiânn」，这是？", "options": ["慢走（送客）", "快点走", "别走"], "answer": 0, "explain": "「慢慢仔」= 慢慢地，是客气的送别语。" },
  { "id": "c-zs20", "soundId": "zs20", "type": "reorder", "prompt": "把词排成「一人一款命」：", "tokens": ["tsi̍t khuán", "tsi̍t lâng", "miā"], "answer": [1, 0, 2], "explain": "「一人」+「一款」+「命」，即每个人一种命运。" },
  { "id": "c-gl01", "soundId": "gl01", "type": "find_object", "prompt": "琴师说「kǹg-khîm」，在图中找出它。", "options": ["钢琴", "风琴", "吉他", "鼓", "二胡", "唢呐"], "answer": 0, "explain": "「钢琴」读 kǹg-khîm，鼓浪屿被称为「钢琴之岛」。" },
  { "id": "c-gl02", "soundId": "gl02", "type": "listen_choose", "prompt": "「tuānn khîm」是什么意思？", "options": ["弹琴", "买琴", "搬琴"], "answer": 0, "explain": "「弹」读 tuānn，「琴」读 khîm。" },
  { "id": "c-gl03", "soundId": "gl03", "type": "listen_choose", "prompt": "「iûnn-lâu」指的是？", "options": ["西式小楼", "庙宇", "渔船"], "answer": 0, "explain": "「洋」= 外来的、西式的，「楼」= 楼房。" },
  { "id": "c-gl04", "soundId": "gl04", "type": "listen_choose", "prompt": "「sann-kak-bûi」是哪种花？", "options": ["三角梅", "茉莉花", "水仙花"], "answer": 0, "explain": "三角梅是厦门市花，「三角」读 sann-kak。" },
  { "id": "c-gl05", "soundId": "gl05", "type": "listen_choose", "prompt": "「Ji̍t-kong-giâm」是鼓浪屿的哪里？", "options": ["日光岩", "菽庄花园", "龙头路"], "answer": 0, "explain": "「日」读 ji̍t，「光」读 kong，「岩」读 giâm。" },
  { "id": "c-gl06", "soundId": "gl06", "type": "dialogue_choice", "prompt": "游客问你去哪里搭船回厦门，你可以说？", "options": ["去渡船头", "去日光岩", "去厝内"], "answer": 0, "explain": "「渡船头」= 码头，在那里坐轮渡。" },
  { "id": "c-gl07", "soundId": "gl07", "type": "reorder", "prompt": "把词排成「我欲坐船」：", "tokens": ["坐船", "我", "欲"], "answer": [1, 2, 0], "explain": "「欲」= 要，语序是「我 + 欲 + 坐船」。" },
  { "id": "c-gl08", "soundId": "gl08", "type": "listen_choose", "prompt": "阿伯说「Hái-hong tsin thàu」，是什么意思？", "options": ["海风很大", "海水很冷", "海边很远"], "answer": 0, "explain": "「透」形容风势强劲。" },
