[
  { "term": "汝", "tailo": "lí", "note": "你。厦门腔常用「汝」，与「你」同源。" },
  { "term": "厝", "tailo": "tshù", "note": "房子、家。「老厝」指祖屋，「厝内」指家里。" },
  { "term": "食", "tailo": "tsia̍h", "note": "吃、喝都用「食」：食饭、食茶。" },
  { "term": "媠", "tailo": "suí", "note": "漂亮、好看。也写作「美」的白读。" },
  { "term": "俗", "tailo": "sio̍k", "note": "便宜。注意不是「俗气」。" },
  { "term": "伤", "tailo": "siunn", "note": "太、过于。「伤贵」= 太贵。" },
  { "term": "偌济", "tailo": "guā-tsē", "note": "多少。问价钱、数量都用它。" },
  { "term": "遮", "tailo": "tsia", "note": "这里。「伫遮」= 在这里。" },
  { "term": "矣", "tailo": "--ah", "note": "句末语气词，表示变化或完成，类似普通话「了」。" },
  { "term": "囡仔", "tailo": "gín-á", "note": "小孩。" },
  { "term": "头家", "tailo": "thâu-ke", "note": "老板。加「娘」成「头家娘」= 老板娘。" },
  { "term": "跋饼", "tailo": "pua̍h-piánn", "note": "博饼。厦门中秋特有的掷骰子民俗。" },
  { "term": "闹热", "tailo": "lāu-lia̍t", "note": "热闹。厦门腔「热」读 lia̍t。" },
  { "term": "古早", "tailo": "kóo-tsá", "note": "从前、传统。「古早味」= 老味道。" },
  { "term": "琴", "tailo": "khîm", "note": "琴。「钢琴」读 kǹg-khîm，鼓浪屿被称为「钢琴之岛」。" },
  { "term": "洋楼", "tailo": "iûnn-lâu", "note": "西式小楼。鼓浪屿上许多是归国华侨所建。" },
  { "term": "番客", "tailo": "huan-kheh", "note": "早年下南洋谋生的闽南人，即海外华侨。" },
  { "term": "讨海", "tailo": "thó-hái", "note": "出海打鱼，向大海讨生活。" },
  { "term": "烧", "tailo": "sio", "note": "热。「烧肉粽」= 热肉粽，不是烤肉。" },
  { "term": "粽", "tailo": "tsàng", "note": "粽子。厦门肉粽馅料丰富。" },
  { "term": "姜母", "tailo": "kiunn-bó", "note": "老姜。「姜母鸭」是秋冬进补名菜。" },
  { "term": "拜拜", "tailo": "pài-pài", "note": "烧香祭拜神明或祖先，不是「再见」。" },
  { "term": "香", "tailo": "hiunn", "note": "供神用的香。「烧香」= sio-hiunn。" },
  { "term": "食菜", "tailo": "tsia̍h-tshài", "note": "吃素，不是单纯吃蔬菜。" },
  { "term": "翕相", "tailo": "hip-siōng", "note": "拍照，闽南话的老说法。" },
  { "term": "日头", "tailo": "ji̍t-thâu", "note": "太阳。「日头落山」= 太阳下山。" },
  { "term": "厝边", "tailo": "tshù-pinn", "note": "邻居。「厝边头尾」= 左邻右舍。" },
  { "term": "敖早", "tailo": "gâu-tsá", "note": "早安。字面是「起得早」，早上见面的问候。" }
]
